# Copy to .env for local runs. No real secrets are needed: every dependency is local and fake.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/policy_workflow
PORT=3000
# Which loops this process runs: "api", "worker", or "all".
ROLE=all
LOG_LEVEL=info

# Fake external services (see src/fakes). Started by `npm run fakes` or docker compose.
PAYMENT_PROVIDER_URL=http://localhost:4001
DOCUMENT_SERVICE_URL=http://localhost:4002
# Where the fake payment provider sends its asynchronous callbacks.
PAYMENT_CALLBACK_URL=http://localhost:3000/webhooks/payments
EXTERNAL_CALL_TIMEOUT_MS=2000

# Outbox relay
RELAY_POLL_INTERVAL_MS=250
RELAY_BATCH_SIZE=10
RELAY_LEASE_MS=15000

# Retry policy (exponential backoff with full jitter)
RETRY_MAX_ATTEMPTS=6
RETRY_BASE_DELAY_MS=500
RETRY_MAX_DELAY_MS=30000

# Tracing: leave empty to keep spans in-process only.
OTEL_EXPORTER_OTLP_ENDPOINT=
