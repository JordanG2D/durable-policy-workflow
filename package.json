{
  "name": "durable-policy-workflow",
  "version": "0.1.0",
  "description": "Durable small-business policy-issuance workflow: state machine, transactional outbox, idempotency, retries, crash recovery, observability.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "dev": "tsx src/main.ts",
    "fakes": "tsx src/fakes/main.ts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/core": "^2.12.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.1",
    "@opentelemetry/resources": "^2.12.1",
    "@opentelemetry/sdk-trace-base": "^2.12.1",
    "@opentelemetry/sdk-trace-node": "^2.12.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
