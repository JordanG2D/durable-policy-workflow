{
  "name": "durable-policy-workflow",
  "version": "0.2.0",
  "private": true,
  "description": "Durable small-business policy-issuance workflow: state machine, transactional outbox, idempotency, retries, crash recovery, observability.",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/domain",
    "packages/parity",
    "packages/handbuilt",
    "packages/temporal",
    "infra"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && npm run typecheck -w @policy/infra",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:integration && npm run test:temporal",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project handbuilt",
    "dev": "npm run dev -w @policy/handbuilt",
    "fakes": "npm run fakes -w @policy/domain",
    "migrate": "npm run migrate -w @policy/handbuilt",
    "test:temporal": "vitest run --project temporal",
    "loc": "node scripts/loc.mjs",
    "aws:synth": "npm run synth -w @policy/infra",
    "aws:diff": "node scripts/aws/operate.mjs diff",
    "aws:deploy": "node scripts/aws/operate.mjs deploy",
    "aws:smoke": "node scripts/aws/smoke.mjs",
    "aws:destroy": "node scripts/aws/operate.mjs destroy",
    "aws:verify-clean": "node scripts/aws/operate.mjs verify-clean",
    "aws:bootstrap": "node scripts/aws/bootstrap.mjs",
    "test:infra": "npm run test -w @policy/infra",
    "test:aws-scripts": "node --test scripts/aws/*.test.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-apigatewayv2": "^3.1167.0",
    "@aws-sdk/client-budgets": "^3.1167.0",
    "@aws-sdk/client-cloudformation": "^3.1167.0",
    "@aws-sdk/client-cloudwatch": "^3.1167.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1167.0",
    "@aws-sdk/client-ec2": "^3.1167.0",
    "@aws-sdk/client-iam": "^3.1167.0",
    "@aws-sdk/client-lambda": "^3.1167.0",
    "@aws-sdk/client-rds": "^3.1167.0",
    "@aws-sdk/client-s3": "^3.1167.0",
    "@aws-sdk/client-scheduler": "^3.1167.0",
    "@aws-sdk/client-secrets-manager": "^3.1167.0",
    "@aws-sdk/client-sqs": "^3.1167.0",
    "@aws-sdk/client-sts": "^3.1167.0",
    "@aws-sdk/credential-provider-node": "^3.972.97",
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.6",
    "aws-cdk": "^2.1148.1",
    "aws-cdk-lib": "^2.276.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
