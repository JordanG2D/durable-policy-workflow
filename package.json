{
  "name": "durable-policy-workflow",
  "version": "0.2.0",
  "private": true,
  "description": "Durable small-business policy-issuance workflow: state machine, transactional outbox, idempotency, retries, crash recovery, observability.",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/domain",
    "packages/parity",
    "packages/handbuilt",
    "packages/temporal"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project handbuilt",
    "dev": "npm run dev -w @policy/handbuilt",
    "fakes": "npm run fakes -w @policy/domain",
    "migrate": "npm run migrate -w @policy/handbuilt"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
